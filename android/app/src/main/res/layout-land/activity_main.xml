<?xml version="1.0" encoding="utf-8"?>
<!-- ponytail: 橫屏=左預覽+右直欄，同名 id，Java 零改動；轉向重建閃斷 1-2 秒 PC 自動重連 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#000000">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/recvView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/previewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#888888"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/tetherBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/usb_tether"
            android:textSize="13sp" />

        <Button
            android:id="@+id/wifiModeBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/wifi_send"
            android:textSize="13sp" />

        <Button
            android:id="@+id/previewBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/close_preview"
            android:textSize="13sp" />

        <Button
            android:id="@+id/freezeBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/freeze"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/usbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wifiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
